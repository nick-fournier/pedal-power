# Example environment variables for Pedal Power Server
# Copy this to .env and customize for your deployment

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=pedalpower
DB_USER=pedalpower
DB_PASSWORD=pedalpower

# MQTT Configuration
MQTT_BROKER=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=bike/telemetry

# Django Configuration
DEBUG=False
SECRET_KEY=change-this-in-production-to-a-long-random-string
ALLOWED_HOSTS=*
